{
	"name": "@micrio/client-src",
	"version": "7.3.0",
	"description": "Micrio client image viewer source repository",
	"main": "micrio.js",
	"type": "module",
	"scripts": {
		"build": "npm run lint && npm run format:check && vite build && vite build --mode minimal && tsc --project tsconfig.docs.json && node bin/bundle.js",
		"build:grid": "node templates/grid/build-grid.js",
		"dev": "vite --port 2000",
		"publish": "node bin/publish.js",
		"docs": "npm run create:client --prefix ../Micrio.Server/doc.micr.io",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:core": "vitest run --project core",
		"test:browser": "vitest run --project browser",
		"test:browser:live": "MICRIO_LIVE=1 vitest run --project browser tests/browser/live",
		"test:watch": "vitest --project core",
		"typecheck": "tsc"
	},
	"keywords": [
		"micrio"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"engineStrict": true,
	"author": "Marcel Duin <marcel@micr.io>",
	"homepage": "https://micr.io/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Q42/Micrio.Client.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"playwright": "^1.59.0",
		"terser": "^5.51.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
