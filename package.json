{
	"name": "@micrio/client-src",
	"version": "7.2.1",
	"description": "Micrio client image viewer source repository",
	"main": "micrio.js",
	"type": "module",
	"scripts": {
		"build": "npm run lint && npm run format:check && vite build && vite build --mode minimal && tsc -d --project tsconfig.docs.json --outFile out.d.ts && node bundle.js",
		"build:grid": "node templates/grid/build-grid.js",
		"dev": "vite --port 2000",
		"publish": "node publish.js",
		"docs": "npm run create:client --prefix ../Micrio.Server/doc.micr.io",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"typecheck": "tsc"
	},
	"keywords": [
		"micrio"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"engineStrict": true,
	"author": "Marcel Duin <marcel@micr.io>",
	"homepage": "https://micr.io/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Q42/Micrio.Client.git"
	},
	"license": "MIT",
	"devDependencies": {
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"terser": "^5.46.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.8"
	}
}
