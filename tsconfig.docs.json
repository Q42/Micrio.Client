{
	"include": ["src/ts/", "src/types/", "src/docs/"],
	"exclude": ["node_modules/*", "__sapper__/*", "public/*"],
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"typeRoots": ["./types"],
		"rootDir": "./src",
		"target": "es2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"emitDeclarationOnly": true,
		"stripInternal": true,
		"paths": {
			"$ts/*": ["./src/ts/*"],
			"$types/*": ["./src/types/*"],
			"$engine/*": ["./src/engine/*"],
			"$core/*": ["./src/core/*"],
			"$media/*": ["./src/media/*"],
			"$ui/*": ["./src/ui/*"],
			"$markers/*": ["./src/markers/*"],
			"$tour/*": ["./src/tour/*"],
			"$gallery/*": ["./src/gallery/*"],
			"$render/*": ["./src/render/*"],
			"$utils/*": ["./src/utils/*"],
			"$audio/*": ["./src/audio/*"],
			"$embed/*": ["./src/embed/*"],
			"$layout/*": ["./src/layout/*"]
		}
	},
	"typedocOptions": {
		"entryPoints": ["./src/docs/micrio.ts", "./src/docs/store.ts"],
		"includes": ["."],
		"excludePrivate": true,
		"excludeInternal": true,
		"excludeExternals": true,
		"includeVersion": true,
		"disableSources": true,
		"darkHighlightTheme": "monokai",
		"lightHighlightTheme": "solarized-light",
		"readme": "./README.md",
		"defaultCategory": "Micrio",
		"name": "Micrio Client",
		"gaID": "G-P1WB0J7VEM",
	}
}
