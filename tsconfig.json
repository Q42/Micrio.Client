{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		// Vitest's `dist/browser.d.ts` uses Node's `BufferEncoding` without importing it, so
		// type-checking the test suites pulls in three `TS2304`s from inside `node_modules`.
		// The alternatives were worse: `types: ["node"]` here would hand Node globals to the
		// source tree, and it breaks `templates/grid/grid.ts` (`setTimeout` becomes
		// `NodeJS.Timeout`, not `number`). Test-owned code is still fully checked.
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"$types/*": ["./src/types/*"],
			"$media/*": ["./src/media/*"],
			"$core/*": ["./src/core/*"],
			"$ui/*": ["./src/ui/*"],
			"$markers/*": ["./src/markers/*"],
			"$tour/*": ["./src/tour/*"],
			"$gallery/*": ["./src/gallery/*"],
			"$render/*": ["./src/render/*"],
			"$utils/*": ["./src/utils/*"],
			"$audio/*": ["./src/audio/*"],
			"$embed/*": ["./src/embed/*"],
			"$layout/*": ["./src/layout/*"],
			"$grid/*": ["./src/grid/*"],
			"$book/*": ["./src/book/*"]
		}
	},
	"include": [
		"src/*.ts",
		"src/types/**/*",
		"src/media/**/*",
		"src/core/**/*",
		"src/ui/**/*",
		"src/markers/**/*",
		"src/tour/**/*",
		"src/gallery/**/*",
		"src/audio/**/*",
		"src/embed/**/*",
		"src/layout/**/*",
		"src/render/**/*",
		"src/utils/**/*",
		"src/grid/**/*",
		"src/book/**/*",
		"build/**/*",
		"templates/**/*",
		"tests/**/*"
	],
	"exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
