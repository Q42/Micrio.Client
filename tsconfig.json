{
	"compilerOptions": {
		"strict": true,
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"$ts/*": ["./src/ts/*"],
			"$types/*": ["./src/types/*"],
			"$engine/*": ["./src/engine/*"]
		}
	},
	"include": [
		"src/types/**/*",
		"src/ts/**/*",
		"src/engine/**/*",
		"src/components/**/*"
	],
	"exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
