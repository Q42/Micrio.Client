{
	"compilerOptions": {
		"strict": true,
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"$types/*": ["./src/types/*"],
			"$engine/*": ["./src/engine/*"],
			"$media/*": ["./src/media/*"],
			"$error/*": ["./src/error/*"],
			"$core/*": ["./src/core/*"],
			"$ui/*": ["./src/ui/*"],
			"$markers/*": ["./src/markers/*"],
			"$tour/*": ["./src/tour/*"],
			"$gallery/*": ["./src/gallery/*"],
			"$render/*": ["./src/render/*"],
			"$utils/*": ["./src/utils/*"],
			"$nav-ui/*": ["./src/nav-ui/*"],
			"$audio/*": ["./src/audio/*"],
			"$embed/*": ["./src/embed/*"],
			"$layout/*": ["./src/layout/*"]
		}
	},
	"include": [
		"src/types/**/*",
		"src/engine/**/*",
		"src/media/**/*",
		"src/error/**/*",
		"src/core/**/*",
		"src/ui/**/*",
		"src/markers/**/*",
		"src/tour/**/*",
		"src/gallery/**/*",
		"src/nav-ui/**/*",
		"src/audio/**/*",
		"src/embed/**/*",
		"src/layout/**/*",
		"src/render/**/*",
		"src/utils/**/*"
	],
	"exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
